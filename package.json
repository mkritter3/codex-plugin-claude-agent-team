{
  "name": "codex-plugin-claude-agent-team",
  "version": "0.1.0",
  "description": "Codex MCP plugin for provider-neutral AI agent teams with Claude Code CLI as the first adapter.",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/mkritter3/codex-plugin-claude-agent-team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkritter3/codex-plugin-claude-agent-team.git"
  },
  "license": "MIT",
  "keywords": ["codex", "mcp", "agents", "claude-code"],
  "codexPlugin": ".codex-plugin/plugin.json",
  "files": [
    "dist",
    ".codex-plugin",
    ".mcp.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/releases",
    "docs/runbooks",
    "scripts"
  ],
  "bin": {
    "agent-team-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/index.ts",
    "install:check": "node scripts/install-check.mjs",
    "smoke:mcp-stdio": "node scripts/smoke-mcp-stdio.mjs",
    "smoke:workflow-orchestrator": "node scripts/smoke-workflow-orchestrator.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "smoke:claude-live": "node scripts/live-smoke-claude-team.mjs",
    "smoke:claude-live-matrix": "node scripts/live-smoke-claude-capability-matrix.mjs",
    "smoke:claude-models": "node scripts/live-smoke-claude-model-profiles.mjs",
    "smoke:providers-live": "node scripts/live-smoke-readonly-providers.mjs",
    "smoke:gemini-write": "node scripts/live-smoke-gemini-write-validation.mjs",
    "smoke:ollama-write": "node scripts/live-smoke-ollama-write-validation.mjs",
    "ci": "npm run typecheck && npm test && npm run build && npm run install:check && npm run smoke:mcp-stdio && npm run smoke:workflow-orchestrator && npm run smoke:package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
